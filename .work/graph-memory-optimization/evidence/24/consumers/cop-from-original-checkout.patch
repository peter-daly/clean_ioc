+"""Fresh-process evidence for the actual Cop composition roots."""
+
+import importlib
+import json
+import sys
+from collections import Counter
+from contextlib import nullcontext
+from typing import get_args
+
+import bark_core.unit_of_work.bundles as uow
+from bark_core.application.commands.messaging import (
+    create_command_consumer_registry,
+    create_reply_consumer_registry,
+)
+from bark_core.application.compiled_dispatchers import (
+    _CommandRoute,
+    _EventRoute,
+    _QueryRoute,
+    _ReplyRoute,
+)
+from bark_core.bark_environment import DeploymentConfig
+from clean_ioc import ComponentActivation, ComponentKind
+
+from data_protection_cop.common.dependencies.build import CONTAINER_BUILD_OPTIONS
+
+
+def inspect_app(app):
+    config_module = importlib.import_module(f"data_protection_cop.apps.{app}.config")
+    config_type = getattr(config_module, f"{app.title()}Config")
+    values = {"bark": DeploymentConfig(env="local")}
+    if app == "api":
+        values["auth"] = {
+            "callers": [
+                {"name": "test", "api_key": "test", "permissions": ["inventory:read"]}
+            ]
+        }
+    config = config_type(**values)
+    get_builder = importlib.import_module(
+        f"data_protection_cop.apps.{app}.container"
+    ).get_builder
+    mandatory, deferred = (
+        uow.validate_unit_of_work_graph,
+        uow.validate_unit_of_work_graph_on_validation,
+    )
+    calls = []
+
+    def required(context):
+        calls.append("mandatory")
+        yield from mandatory(context)
+
+    def explicit(context):
+        calls.append("deferred")
+        yield from deferred(context)
+
+    uow.validate_unit_of_work_graph = required
+    uow.validate_unit_of_work_graph_on_validation = explicit
+    rows = []
+    for mode in ("run", "analysis"):
+        calls.clear()
+        builder = get_builder(config)
+        # Capture this builder's real declaration IDs, including decorators.
+        declared = {
+            registration.id
+            for registrations in builder._composition._registry._registrations.values()
+            for registration in registrations
+        } | {decorator.id for decorator in builder._decorators}
+        with (
+            (
+                CONTAINER_BUILD_OPTIONS.analyse(builder)
+                if mode == "analysis"
+                else nullcontext(None)
+            ) as analysis,
+            (
+                analysis.create_runtime()
+                if analysis is not None
+                else CONTAINER_BUILD_OPTIONS.build(builder)
+            ) as container,
+        ):
+            assert calls == (["mandatory", "deferred"] if mode == "analysis" else [])
+            selected = container.selected_registrations
+            assert {item.id for item in selected} <= declared
+            catalogue = sorted(
+                [
+                    (
+                        str(item.service_type),
+                        str(item.implementation_type),
+                        item.name,
+                        repr(item.tags),
+                    )
+                    for item in selected
+                ],
+                key=repr,
+            )
+            routes = {
+                route: [item for item in selected if item.service_type is route]
+                for route in (_CommandRoute, _EventRoute, _QueryRoute, _ReplyRoute)
+            }
+            assert all(not container.has_component(route) for route in routes)
+            assert not container._plan.provider_roots
+            with container.new_scope() as scope:
+                commands = create_command_consumer_registry(scope)
+                replies = create_reply_consumer_registry(scope)
+                commands.validate()
+                replies.validate()
+                command_types = sorted(str(item) for item in commands.command_types)
+                reply_types = sorted(str(item) for item in replies.reply_types)
+            graph_evidence = None
+            report = None if analysis is None else analysis.report
+            if mode == "analysis":
+                report = analysis.report
+                assert calls == ["mandatory", "deferred"]
+                graph_evidence = {
+                    "private_routes": sum(
+                        visit.component.service_type in routes
+                        for visit in analysis.graph.walk()
+                    ),
+                    "deferred_providers": sum(
+                        visit.component.kind is ComponentKind.provider
+                        and visit.component.activation is ComponentActivation.deferred
+                        for visit in analysis.graph.walk()
+                    ),
+                    "decorators": sum(
+                        visit.component.kind is ComponentKind.decorator
+                        for visit in analysis.graph.walk()
+                    ),
+                }
+            assert report is None or not report.errors, [
+                (i.code, i.message) for i in report.errors
+            ]
+            rows.append(
+                {
+                    "mode": mode,
+                    "catalogue": catalogue,
+                    "selected": len(selected),
+                    "roots": len(container.components),
+                    "commands": command_types,
+                    "replies": reply_types,
+                    "route_messages": {
+                        route.__name__: sorted(
+                            str(get_args(item.implementation_type)[0])
+                            for item in entries
+                        )
+                        for route, entries in routes.items()
+                    },
+                    "uow_calls": list(calls),
+                    "validation_findings": dict(
+                        Counter(
+                            issue.code
+                            for issue in (() if report is None else report.issues)
+                        )
+                    ),
+                    "graph_evidence": graph_evidence,
+                }
+            )
+    assert rows[0]["catalogue"] == rows[1]["catalogue"]
+    return rows
+
+
+if __name__ == "__main__":
+    print(json.dumps(inspect_app(sys.argv[1])))
