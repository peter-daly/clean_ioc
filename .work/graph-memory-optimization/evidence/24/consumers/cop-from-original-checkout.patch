+import json
+import subprocess
+import sys
+from contextlib import nullcontext
+from pathlib import Path
+from unittest.mock import create_autospec
+
+import pytest
+from bark_core.application.commands import CommandDispatcher
+from bark_core.bundles import unit_of_work_resource_tag
+
+from data_protection_cop.apps.api.container import get_builder as get_api_builder
+from data_protection_cop.apps.worker.container import get_builder
+from data_protection_cop.common.dependencies.build import CONTAINER_BUILD_OPTIONS
+from data_protection_cop.common.registrations.domain.commands import (
+    CreateServiceRegistrationCommand,
+)
+from data_protection_cop.common.registrations.domain.models import (
+    RegisteredDataProtectionService,
+)
+from data_protection_cop.common.registrations.domain.repository import (
+    ServiceRegistryRepository,
+)
+from tests.asgi import provide_http_connection
+from tests.unit.test_api_registrations import valid_api_config
+from tests.unit.test_worker_foundation import valid_worker_config
+
+
+@pytest.mark.parametrize("app", ["api", "worker"])
+def test_real_cop_modes_preserve_discovery_and_uow_validation(app):
+    # Subclass discovery must not see handlers defined by other collected tests.
+    result = subprocess.run(
+        [sys.executable, "-m", "tests.compiled_modes_probe", app],
+        cwd=Path(__file__).resolve().parents[2],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    run, analysis = json.loads(result.stdout)
+    assert run["catalogue"] == analysis["catalogue"]
+    assert run["commands"] == analysis["commands"]
+    assert run["replies"] == analysis["replies"] == []
+    assert any("CreateInventoryRequestCommand" in name for name in run["commands"])
+    assert any(
+        "CreateServiceRegistrationCommand" in name
+        for name in run["route_messages"]["_CommandRoute"]
+    )
+    # Registration commands are routed locally but have no inbound wire type.
+    assert not any(
+        "CreateServiceRegistrationCommand" in name for name in run["commands"]
+    )
+    assert any(
+        "TerminateInventoryResultPartCommand" in name for name in run["commands"]
+    )
+    assert run["uow_calls"] == []
+    assert analysis["uow_calls"] == ["mandatory", "deferred"]
+    assert analysis["graph_evidence"]["private_routes"] > 0
+    assert analysis["graph_evidence"]["deferred_providers"] > 0
+    assert analysis["graph_evidence"]["decorators"] > 0
+    if app == "worker":
+        assert any(
+            "ServiceInventoryProgressChanged" in name
+            for name in run["route_messages"]["_EventRoute"]
+        )
+        assert any("_CopExecutorDecorator" in item[1] for item in run["catalogue"])
+    else:
+        assert any(
+            "GetInventoryQuery" in name for name in run["route_messages"]["_QueryRoute"]
+        )
+
+
+@pytest.mark.parametrize("mode", ["run", "analysis"])
+def test_cop_modes_reject_transaction_resources_with_invalid_lifespan(mode):
+    class TransactionalResource:
+        pass
+
+    builder = get_builder(valid_worker_config())
+    builder.register(
+        TransactionalResource,
+        lifespan="transient",
+        tags=[unit_of_work_resource_tag(None)],
+    )
+    if mode == "run":
+        with CONTAINER_BUILD_OPTIONS.build(builder) as runtime:
+            assert runtime.resolve(TransactionalResource) is not None
+    else:
+        with CONTAINER_BUILD_OPTIONS.analyse(builder) as analysis:
+            assert "uow-scope-mismatch" in {
+                issue.code for issue in analysis.report.errors
+            }
+
+
+@pytest.mark.parametrize("mode", ["run", "analysis"])
+async def test_api_modes_dispatch_through_the_real_decorated_registration_route(mode):
+    repository = create_autospec(
+        ServiceRegistryRepository, instance=True, spec_set=True
+    )
+    service = RegisteredDataProtectionService(
+        service_id="mode-test",
+        request_queue_name="mode-test-requests",
+        partition_key="v2",
+    )
+    repository.create.return_value = service
+    builder = get_api_builder(valid_api_config())
+    builder.register(ServiceRegistryRepository, instance=repository)
+
+    async with (
+        (
+            CONTAINER_BUILD_OPTIONS.analyse(builder)
+            if mode == "analysis"
+            else nullcontext(None)
+        ) as analysis,
+        (
+            analysis.create_runtime()
+            if analysis is not None
+            else CONTAINER_BUILD_OPTIONS.build(builder)
+        ) as container,
+    ):
+        async with container.new_scope() as scope:
+            provide_http_connection(scope)
+            dispatcher = await scope.resolve_async(CommandDispatcher)
+            command = CreateServiceRegistrationCommand(
+                service_id=service.service_id,
+                request_queue_name=service.request_queue_name,
+                partition_key=service.partition_key,
+            )
+            result = await dispatcher.dispatch(command)
+
+    repository.create.assert_awaited_once_with(service)
+    assert result.command is command
+    assert result.properties.partition_key == "v2"
