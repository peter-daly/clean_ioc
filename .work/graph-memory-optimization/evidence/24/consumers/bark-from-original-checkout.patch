+@pytest.mark.parametrize("mode", ["run", "analysis"])
+def test_unit_of_work_build_modes_preserve_both_validation_rules(monkeypatch, mode):
+    import bark_core.unit_of_work.bundles as uow_bundles
+
+    calls = []
+    mandatory = uow_bundles.validate_unit_of_work_graph
+    deferred = uow_bundles.validate_unit_of_work_graph_on_validation
+
+    def record_mandatory(context):
+        calls.append("mandatory")
+        yield from mandatory(context)
+
+    def record_deferred(context):
+        calls.append("deferred")
+        yield from deferred(context)
+
+    monkeypatch.setattr(uow_bundles, "validate_unit_of_work_graph", record_mandatory)
+    monkeypatch.setattr(uow_bundles, "validate_unit_of_work_graph_on_validation", record_deferred)
+    builder = _sqlalchemy_repository_builder(
+        WritingRepositoryCommandHandler, SqlAlchemyWritingRepository, unit_of_work=False
+    )
+    with (
+        builder.analyse() if mode == "analysis" else nullcontext(None) as container_analysis,
+        container_analysis.create_runtime() if container_analysis is not None else builder.build() as container,
+    ):
+        assert calls == (["mandatory", "deferred"] if mode == "analysis" else [])
+        if mode == "analysis":
+            report = container_analysis.report
+            assert calls == ["mandatory", "deferred"]
+            assert "uow-sqlalchemy-write-without-boundary" in {issue.code for issue in report.errors}
