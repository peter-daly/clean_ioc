+async def test_consumer_catalogue_has_the_same_semantic_entries_in_run_and_analysis(family):
+    from bark_core.application.commands.messaging import (
+        create_command_consumer_registry,
+        create_reply_consumer_registry,
+    )
+    from bark_core.messaging import messaging_type
+
+    base = Command if family == "command" else Reply
+    Inbound = messaging_type(name_override=f"{family}-equivalent")(type("Inbound", (base,), {}))
+    calls = []
+
+    class Handler:
+        async def handle(self, message):
+            calls.append(message)
+            if family == "command":
+                return CommandResult.from_command(message)
+
+    handler, routes, dispatcher, registry = {
+        "command": (CommandHandler, _register_command_routes, CommandDispatcher, create_command_consumer_registry),
+        "reply": (ReplyHandler, _register_reply_routes, ReplyDispatcher, create_reply_consumer_registry),
+    }[family]
+    catalogues = []
+    for mode in ("run", "analysis"):
+        builder = ContainerBuilder()
+        handler_id = builder.register(handler[Inbound], Handler)
+        routes(builder, (Inbound,))
+        builder.set_provider_roots(())
+        async with (
+            builder.analyse() if mode == "analysis" else nullcontext(None) as container_analysis,
+            container_analysis.create_runtime() if container_analysis is not None else builder.build() as container,
+            container.new_scope() as scope,
+        ):
+            entries = container.selected_registrations
+            assert any(entry.id == handler_id and entry.service_type == handler[Inbound] for entry in entries)
+            catalogues.append(
+                {(entry.service_type, entry.implementation_type, entry.name, entry.tags) for entry in entries}
+            )
+            contract = registry(scope)
+            assert getattr(contract, f"{family}_types") == (Inbound,)
+            contract.validate()
+            message = Inbound()
+            await (await scope.resolve_async(dispatcher)).dispatch(message)
+            assert calls[-1] is message
+    assert catalogues[0] == catalogues[1]
+    assert len(calls) == 2
