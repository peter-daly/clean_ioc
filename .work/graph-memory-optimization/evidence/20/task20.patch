+    with builder.build() as runtime:
+        assert isinstance(runtime, Container)
+        assert isinstance(runtime.resolve(Service).leaf, Leaf)
+        assert runtime._plan.build_report is None
+        assert runtime._plan.validation_rules == ()
+    assert events == []
