+@pytest.mark.parametrize("mode", ["run", "analysis"])
+def test_saved_overlay_source_keeps_boundary_and_parent_singleton_dependencies(mode):
+    from clean_ioc import Expose, Tag
+
+    builder = ContainerBuilder()
+    builder.set_provider_roots(())
+    boundary = builder.create_boundary("provider", exposes=(Expose(Source),))
+    resource_id = boundary.register(Resource, lifespan="singleton", tags=(Tag("owner", "parent"),))
+    boundary.register(Source, lifespan="singleton")
+    saved = []
+    with builder.build(mode="analysis") as parent:
+        existing = parent.resolve(Source)
+        overlay = parent.new_scope_builder()
+        overlay.set_provider_roots(())
+        overlay.register(Resource, lifespan="singleton", tags=(Tag("owner", "child"),))
+        overlay.register(Target[int])
+
+        def source_filter(component):
+            assert component.boundary == "provider"
+            assert component.dependencies[0].id == resource_id
+            assert component.dependencies[0].has_tag("owner", "parent")
+            saved.append((component, snapshot_facts(component)))
+            return True
+
+        overlay.register_decorator_template(
+            for_each=Source,
+            source_filter=source_filter,
+            template=lambda _: DecoratorTemplate(DerivedServices(Target[int]), Wrapper),
+        )
+        with overlay.build(mode=mode) as child:
+            assert child.resolve(Source) is existing
+            assert isinstance(child.resolve(Target[int]), Wrapper)
+    assert saved
+    for component, facts in saved:
+        assert snapshot_facts(component) == facts
+        assert component.dependencies[0].id == resource_id
+        assert component.dependencies[0].boundary == "provider"
+        assert component.decorators == ()
