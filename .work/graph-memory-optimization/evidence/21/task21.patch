+class Leaf:
+    pass
+
+
+class Service:
+    def __init__(self, leaf: Leaf):
+        self.leaf = leaf
+
+
+def builder():
+    result = ContainerBuilder().set_provider_roots(())
+    result.register(Leaf, lifespan="singleton", root_policy="dependency_only")
+    result.register(Service)
+    return result
